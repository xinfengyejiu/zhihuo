# 数据库(留空使用本地 SQLite;生产建议 PostgreSQL)
DATABASE_URL=postgresql+psycopg://xiaohuo:xiaohuo_pass_change_me@localhost:5432/xiaohuo

# 必改:强随机密钥(api_key 加密与 JWT 签发都依赖它)
SECRET_KEY=please_change_this_to_a_long_random_string

# 允许的前端来源(逗号分隔);局域网私网还会走 cors_origin_regex
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.12.113:3000
